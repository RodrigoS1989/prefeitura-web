<!DOCTYPE html>
@let(theme = request.plainCookie('app_theme', { defaultValue: 'light', encoded: false }))
<html class="{{ theme === 'dark' ? 'dark' : '' }}" data-theme="{{ theme }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-inertia>
      Prefeitura Web - Gestão Municipal
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body class="font-sans antialiased min-h-screen bg-background text-foreground">
    @inertia()
  </body>

</html>
